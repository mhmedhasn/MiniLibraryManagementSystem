{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=AccountTestApp;Trusted_Connection=True;TrustServerCertificate=True;"
  },
    
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WirteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "MiniLibraryMAnagementSystem"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LocalNetworkAddress": {
    "Command": "sqlcmd -S np:.\\ -Q \"SELECT DISTINCT local_net_address, local_tcp_port FROM sys.dm_exec_connections WHERE local_net_address IS NOT NULL;\""
  },
  "ServiceRestart": {
    "Command": "Restart-Service MSSQLSERVER -Force"
  },
  "SQLBrowser": {
    "Command": "Set-Service -Name SQLBrowser -StartupType Automatic; Start-Service SQLBrowser"
  },
  "Firewall": {
    "Command": "New-NetFirewallRule -DisplayName \"Allow SQL Server TCP 1433\" -Direction Inbound -Protocol TCP -LocalPort 1433 -Action Allow"
  }
}